{
  "name": "book-journal",
  "private": true,
  "version": "0.2.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
